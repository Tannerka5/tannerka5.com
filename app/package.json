        "@dnd-kit/sortable": "^8.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@tailwindcss/vite": "^4.1.18",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "astro": "^5.16.6",
        "framer-motion": "^12.23.26",
        "isomorphic-dompurify": "^3.21.0",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "tailwindcss": "^3.4.19",
