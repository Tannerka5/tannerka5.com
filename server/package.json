{
  "name": "server",
  "version": "1.0.0",
  "description": "Serverless backend for portfolio website using TypeScript, Lambda, API Gateway, and DynamoDB",
  "main": "dist/handler.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist lambda.zip",
    "package": "npm run build && npm run zip",
    "zip": "node scripts/zip.js",
    "deploy": "npm run clean && npm run package",
    "export": "node export-data.js",
    "export:projects": "node export-data.js --projects-only",
    "export:blog": "node export-data.js --blog-only",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "aws",
    "lambda",
    "typescript",
    "dynamodb",
    "api-gateway",
    "serverless"
  ],
  "author": "Tanner Atkinson",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.958.0",
    "@aws-sdk/client-s3": "^3.966.0",
    "@aws-sdk/lib-dynamodb": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.966.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.159",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^25.0.3",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "adm-zip": "^0.6.0",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
